<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/search_view"
    android:padding="5dp"
  >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đổi Mật Khẩu"
        android:textSize="25dp"
        android:gravity="center"
        android:padding="10dp"
        android:textStyle="bold"
        android:textColor="#03A80A"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        >

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layout_gravity="center"
            android:background="@drawable/search_view"

            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal"
            >
            <EditText
                android:id="@+id/dialog_edittext_passnv1"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="60dp"
                android:gravity="center"

                android:textSize="20dp"
                android:background="@color/white"
                android:layout_marginLeft="10dp"
                android:inputType="numberPassword"

                />
            <FrameLayout
                android:layout_width="0dp"
                android:id="@+id/dialog_framl_xempass1"
                android:layout_weight="0.2"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_baseline_remove_red_eye_24"
                    android:layout_margin="10dp"

                    android:layout_gravity="center"></ImageView>
            </FrameLayout>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="New PassWord"
            android:textColor="#105083"
            android:textStyle="bold"
            android:background="@color/white"
            android:textSize="17dp"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_marginLeft="20dp"/>


    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        >

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:layout_gravity="center"
            android:background="@drawable/search_view"

            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal"
            >
            <EditText
                android:id="@+id/dialog_edittext_passnv2"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="60dp"
                android:gravity="center"

                android:textSize="20dp"
                android:background="@color/white"
                android:layout_marginLeft="10dp"
               android:inputType="numberPassword"

                />
            <FrameLayout
                android:layout_width="0dp"
                android:id="@+id/dialog_framl_xempass2"
                android:layout_weight="0.2"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_baseline_remove_red_eye_24"
                    android:layout_margin="10dp"

                    android:layout_gravity="center"></ImageView>
            </FrameLayout>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhập Lại PassWord"
            android:textColor="#105083"
            android:textStyle="bold"
            android:background="@color/white"
            android:textSize="17dp"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_marginLeft="20dp"/>


    </FrameLayout>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Update"
        android:textSize="18dp"
        android:textColor="#F1EAEA"
        android:paddingRight="25dp"
        android:paddingLeft="25dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:backgroundTint="#C1299E2E"
        android:layout_marginBottom="10dp"
        android:id="@+id/dialog_button_updatepass"/>


</LinearLayout>