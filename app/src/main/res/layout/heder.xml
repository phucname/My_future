<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"


   >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#B0182675">
     <FrameLayout
         android:layout_width="130dp"
         android:layout_height="wrap_content"
         android:layout_gravity="center">
         <de.hdodenhof.circleimageview.CircleImageView
             android:layout_width="100dp"
             android:layout_height="100dp"

             android:layout_marginTop="20dp"
             android:layout_marginBottom="8dp"
             android:id="@+id/img_herder"

             android:src="@drawable/backfound_dangnhap"
             />
         <ImageView
             android:id="@+id/img_setting_herder"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:src="@drawable/ic_baseline_auto_fix_normal_24"
             android:layout_gravity="bottom|right"

             android:layout_marginTop="10dp"


             />
     </FrameLayout>

        <TextView
            android:padding="4dp"
            android:id="@+id/text_hedre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20dp"

            android:textColor="@color/white"
            android:gravity="center"

            android:text="Null"/>
        <TextView
            android:padding="4dp"
            android:id="@+id/text_chucvu_hedre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20dp"
          android:gravity="center"
            android:textColor="#FDFDFD"
            android:text="Null"
            android:layout_marginBottom="10dp"/>
    </LinearLayout>




</FrameLayout>