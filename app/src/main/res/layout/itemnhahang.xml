<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linernhahang"
    android:orientation="vertical"
    android:layout_marginBottom="5dp"
    android:layout_marginRight="13dp"
    android:layout_marginLeft="13dp"
    android:padding="5dp"
    android:background="@drawable/search_view"
    >

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="20dp"
       >
        <ImageView
            android:id="@+id/img_nhahang"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:scaleType="fitXY"
            android:src="@drawable/nha_han"></ImageView>


        <TextView
            android:id="@+id/texttennhahang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:background="#A19A9A"
            android:layout_gravity="top|right"
            android:padding="5dp"
            android:text="AGonma"
            android:textColor="#FBF9F9"
            android:textSize="20dp"
            android:textStyle="bold" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginLeft="10dp"

            android:layout_marginTop="5dp"
            >
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="matrix"
                android:src="@drawable/ic_baseline_location_on_24"></ImageView>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="34 Quan Trung ngô thừa nhiệm"
                android:id="@+id/text_diachinhahang"
                android:textSize="18dp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:textColor="#20C527"></TextView>
        </LinearLayout>
    </LinearLayout>





</LinearLayout>