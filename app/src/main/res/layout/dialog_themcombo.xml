<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/search_view">
        <ImageView
            android:id="@+id/img_them_combo"
            android:layout_width="150dp"
            android:layout_height="150dp"
         android:background="@drawable/search_view"
            android:src="@drawable/icon"
            android:padding="5dp"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="5dp"
            android:scaleType="fitXY"
            android:layout_gravity="center"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <EditText
                android:id="@+id/edittext_tencombo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tên ComBo"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:textSize="22dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Giá củ"
                android:textSize="22dp"
                android:padding="5dp"
                android:layout_marginBottom="10dp"
                android:id="@+id/text_tonggia_combo"/>
            <EditText
                android:id="@+id/edittext_giacombo"
                android:layout_width="match_parent"
                android:layout_marginBottom="10dp"
                android:layout_height="wrap_content"
                android:hint="Giá Mới"
                android:textSize="22dp"/>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:id="@+id/button_themcombo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thêm Combo"
        android:textStyle="bold"
        android:textSize="17dp"
        android:layout_gravity="center"
        android:textAllCaps="false"
        android:layout_marginTop="10dp"
       android:paddingBottom="12dp"
        android:paddingTop="12dp"
        android:backgroundTint="#6EBF10"/>

</LinearLayout>