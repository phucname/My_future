<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity.GoiMonActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
       >
    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView

        android:id="@+id/goimonimg"
        android:layout_width="match_parent"
        android:scaleType="fitXY"
        android:layout_height="180dp"
        android:src="@drawable/backgound_dangnhap"
        android:layout_gravity="center"/>
    <TextView
        android:layout_marginTop="20dp"
        android:id="@+id/goimontenmonan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gà Hầm"
        android:layout_marginStart="10dp"
        android:textSize="20dp"
        android:textColor="#0C0B0E"
        android:textStyle="bold"
        />
        <TextView
            android:layout_marginTop="1dp"
            android:id="@+id/loaimon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loại"
            android:layout_marginStart="10dp"
            android:textSize="18dp"
            android:textColor="#0C0B0E"
            android:textStyle="bold"
            />


       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="horizontal">
           <TextView

               android:layout_width="wrap_content"

               android:layout_height="wrap_content"
               android:textSize="20sp"
               android:layout_marginStart="10dp"
               android:textStyle="bold"
               android:layout_marginTop="10dp"
               android:text="Giá:"
               android:textColor="#EF3A03"
               />
           <TextView
               android:id="@+id/goimongia"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:textSize="20sp"
              android:layout_marginStart="5dp"
               android:textStyle="bold"
               android:layout_marginTop="10dp"
               android:text="12000.VND"
               android:textColor="#EF3A03"
               />
           <TextView
               android:id="@+id/goimon_giakhuyenmai"
               android:layout_width="wrap_content"

               android:layout_height="wrap_content"
               android:textSize="20sp"
               android:layout_marginStart="10dp"
               android:textStyle="bold"
               android:layout_marginTop="10dp"
               android:text="12000.VND"
               android:visibility="invisible"
               android:textColor="#EF3A03"
               />
       </LinearLayout>
        <TextView
            android:id="@+id/goimon_giatrikm"
            android:layout_width="match_parent"

            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:layout_marginStart="10dp"
            android:textStyle="bold"
     android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:text="Giảm:10%"
            android:visibility="invisible"
            android:textColor="#129517"
            />



    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="#F8A730"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"

        android:text="Mô tả chi tiết"
        android:textColor="#FF9800"
        android:textSize="20dp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>
    <TextView

        android:id="@+id/goimonchitiettt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:paddingStart="10dp"
        android:textColor="#7C7272"

        android:text="Hamburger[a] (tiếng Việt đọc là hăm-bơ-gơ hay hem-bơ-gơ,
        hamburger có topping là pho mát được mọi người gọi là hamburger pho mát.[1]"
        android:textSize="20dp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="5dp"
            android:background="@color/black"></View>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20dp"
            android:textColor="#128717"

            android:layout_margin="10dp"
            android:text="Món Ăn Gợi Ý"></TextView>




<androidx.recyclerview.widget.RecyclerView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/recyclerview_dexuatmon">

</androidx.recyclerview.widget.RecyclerView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="ComBo Gợi ý"
            android:layout_marginLeft="20dp"
            android:textColor="#D88A16"
            android:textSize="20dp"></TextView>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/recyclerview_combo_goiy"/>
</LinearLayout>
</ScrollView>
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:id="@+id/linew_goimon"
    android:layout_gravity="bottom">
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/black"></View>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F8F8F8">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:maxHeight="60dp"
                android:orientation="horizontal"
                android:layout_weight="0.7"
                android:padding="5dp"
                android:layout_gravity="center">
                <FrameLayout
                    android:id="@+id/framelayout_tru_hoadon"
                    android:layout_width="0dp"
                    android:layout_weight="0.15"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/goimonslgiam"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/search_view"
                        android:layout_gravity="center"


                        />
                    <ImageView

                        android:layout_width="20sp"
                        android:layout_height="20sp"
                        android:src="@drawable/ic_baseline_remove_24"
                        android:layout_gravity="center"



                        />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_weight="0.2"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    >
                    <ImageView

                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/vien_bo_red"
                        android:layout_gravity="center"
                        />
                    <TextView
                        android:id="@+id/goimonsoluong"
                        android:layout_width="match_parent"
                        android:autoSizeMaxTextSize="30dp"
                        android:autoSizeMinTextSize="10dp"
                        android:autoSizeStepGranularity="2sp"
                        android:autoSizeTextType="uniform"

                        android:layout_height="match_parent"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:textStyle="bold"

                        android:textColor="@color/black"
                        android:text="1"/>

                </FrameLayout>


                <FrameLayout android:id="@+id/framelayout_cong_mon"

                    android:layout_width="0dp"
                    android:layout_weight="0.15"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/img_tangsl_giohang"
                        android:layout_width="match_parent"

                        android:layout_height="match_parent"
                        android:background="@drawable/search_view"
                        android:layout_gravity="center"


                        />
                    <ImageView
                        android:layout_width="20sp"
                        android:layout_height="20sp"
                        android:src="@drawable/ic_baseline_add_24"
                        android:layout_gravity="center"
                    android:id="@+id/goimonsltang"

                        />
                </FrameLayout>
            </LinearLayout>



        <Button
            android:id="@+id/goimonbutton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:text="Thêm Vào Giỏ"
            android:gravity="center"
            android:textSize="15dp"
            android:backgroundTint="#8BC34A"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"

            />
    </LinearLayout>
</LinearLayout>
    <TextView
        android:id="@+id/tex_dathem"
       android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đã Thêm Vào Giỏ"
        android:layout_gravity="bottom"
        android:padding="10dp"
        android:textSize="25dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:background="#FF9800"/>
