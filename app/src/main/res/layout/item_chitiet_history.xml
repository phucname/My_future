<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:id="@+id/linear_hoadon">
    <ImageView
        android:id="@+id/hoadonimg_chitiet_history"
        android:layout_width="100dp"
        android:layout_height="83dp"
        android:scaleType="fitXY"
        android:src="@drawable/backgound_dangnhap"
        android:layout_margin="10dp"
        android:layout_gravity="center"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:orientation="vertical"

            >

            <TextView
                android:id="@+id/hoadontenmon_chitiet_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gõi Đu Đu"
                android:textColor="#1C1C1C"
                android:textSize="20dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hoadongia_chitiet_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:text="Giá:120000"
                android:textColor="#FFA014"
                android:textSize="17dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/soluong_chitiet_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Số Lượng:2"
                android:textSize="17dp" />
            <!--      <TextView-->
            <!--          android:id="@+id/tonggiamon"-->
            <!--          android:layout_width="match_parent"-->
            <!--          android:layout_height="wrap_content"-->
            <!--          android:textSize="20dp"-->
            <!--          android:layout_marginTop="10dp"-->
            <!--          android:textStyle="bold"/>-->

        </LinearLayout>


    </FrameLayout>




</LinearLayout>