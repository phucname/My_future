<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/search_view"
    android:orientation="vertical">
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Giảm Giá"
    android:background="@drawable/bach_roi_orga"
    android:padding="6dp"
    android:textSize="20dp"
    android:textColor="@color/white"
    android:gravity="center"/>
    <Spinner
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:id="@+id/dialog_Spiner_giamgia"
        android:layout_marginTop="5dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"/>
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Giá trị giảm"
        android:textSize="20dp"
        android:padding="10dp"
        android:id="@+id/dialog_giatrigiam"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="65dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/search_view"/>
    <LinearLayout
        android:layout_marginTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp">
        <TextView
            android:layout_width="wrap_content"
           android:padding="5dp"
            android:layout_height="match_parent"
            android:text="Từ:"
            android:layout_marginRight="8dp"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="22dp"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"

            android:orientation="horizontal"
            android:background="@drawable/search_view">
            <ImageView
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/ic_baseline_date_range_24"
                android:id="@+id/dialog_img_lich_tu"
                android:padding="5dp"

                android:background="@drawable/search_view"></ImageView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20dp"
                android:gravity="center"
                android:padding="5dp"
                android:id="@+id/dialog_text_lich_tu"
                android:text="12/5/2023"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_marginTop="15dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:padding="5dp"
            android:layout_height="match_parent"
            android:text="Đến:"
            android:textStyle="bold"
            android:gravity="center"
            android:textSize="22dp"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"

            android:orientation="horizontal"
            android:background="@drawable/search_view">
            <ImageView
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/ic_baseline_date_range_24"
                android:id="@+id/dialog_img_lich_den"
                android:padding="5dp"
                android:background="@drawable/search_view"></ImageView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20dp"
                android:gravity="center"
                android:padding="5dp"
                android:id="@+id/dialog_text_lich_den"
                android:text="12/5/2023"/>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15dp"
        android:text="Thêm"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:id="@+id/dialog_button_them_mongiamgia"
        android:textAllCaps="false"
        android:backgroundTint="#239827"
        android:layout_marginBottom="10dp"/>

</LinearLayout>