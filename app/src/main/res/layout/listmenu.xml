<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
   >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >
        <ImageView
            android:id="@+id/img_mon_combo"
            android:layout_width="140dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:src="@drawable/backgoundb"
            android:scaleType="fitXY"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginLeft="10dp">
            <TextView
                android:id="@+id/text_tenmon_combo"
                android:layout_width="150dp"
                android:layout_marginBottom="5dp"
                android:layout_height="wrap_content"
                android:textSize="20dp"
                android:text="tenmon"/>
            <TextView
                android:id="@+id/text_giamon_combo"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:textSize="20dp"
                android:text="Gia"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                >
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:layout_weight="0.7"
                    android:padding="5dp"
                    android:layout_gravity="center">
                    <FrameLayout
                        android:id="@+id/frame_item_tru_slcombo"
                        android:layout_width="0dp"
                        android:layout_weight="0.15"
                        android:layout_height="match_parent">
                        <ImageView

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/search_view"
                            android:layout_gravity="center"


                            />
                        <ImageView

                            android:layout_width="20sp"
                            android:layout_height="20sp"
                            android:src="@drawable/ic_baseline_remove_24"
                            android:layout_gravity="center"



                            />
                    </FrameLayout>
                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_weight="0.2"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        >
                        <ImageView

                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/vien_bo_red"
                            android:layout_gravity="center"
                            />
                        <TextView
                            android:id="@+id/text_item_sl_combo"
                            android:layout_width="match_parent"
                            android:autoSizeMaxTextSize="30dp"
                            android:autoSizeMinTextSize="10dp"
                            android:autoSizeStepGranularity="2sp"
                            android:autoSizeTextType="uniform"

                            android:layout_height="match_parent"
                            android:textSize="10sp"
                            android:gravity="center"
                            android:textStyle="bold"

                            android:textColor="@color/black"
                            android:text="1"/>

                    </FrameLayout>


                    <FrameLayout android:id="@+id/framelayout_item_cong_slcombo"

                        android:layout_width="0dp"
                        android:layout_weight="0.15"
                        android:layout_height="match_parent">
                        <ImageView

                            android:layout_width="match_parent"

                            android:layout_height="match_parent"
                            android:background="@drawable/search_view"
                            android:layout_gravity="center"


                            />
                        <ImageView
                            android:layout_width="20sp"
                            android:layout_height="20sp"
                            android:src="@drawable/ic_baseline_add_24"
                            android:layout_gravity="center"


                            />
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>



<Button
   android:id="@+id/button_themmon_combo"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textStyle="bold"
          android:text="Thêm"
    android:layout_gravity="right"/>
    <Button
        android:id="@+id/button_dathem_combo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:text="Đã Thêm"
        android:visibility="invisible"
        android:layout_gravity="right"/>


</FrameLayout>