<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF">
    <TextView
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:text="Ghi Chú Món Ăn"
        android:padding="6dp"
       android:background="@drawable/bach_roi_orga"/>
    <EditText
        android:id="@+id/dialog_editex_chat"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:textSize="20dp"
        android:textStyle="bold"
        android:layout_margin="20dp"
        android:gravity="center"

        android:background="@drawable/search_view"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <Button
            android:id="@+id/dialog_button_chat"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Ok"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            android:backgroundTint="#8AE61F"/>
        <Button
            android:id="@+id/dialog_button_chat_candel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:layout_height="wrap_content"
            android:text="Canled"
            android:alpha="0.6"
            android:backgroundTint="#686464"
            android:layout_marginStart="10dp"
            />
    </LinearLayout>

</LinearLayout>