<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity.Fragment_GioHang">


     <LinearLayout
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:orientation="vertical">
         <TextView
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:text="Giỏ Hàng"
             android:textSize="25dp"
             android:textStyle="bold"
             android:gravity="center"
             android:padding="10dp"
             android:textColor="#FFFCF7"
             android:layout_marginBottom="20dp"
             android:background="@drawable/rour_bac"/>


                 <ListView
                     android:layout_width="match_parent"
                     android:layout_height="0dp"
                     android:layout_weight="1"
                     android:id="@+id/listview_giohang"
                     />





     </LinearLayout>


   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="60dp"
       android:orientation="horizontal"

       android:layout_gravity="bottom|right"
       android:background="#CAC7C7">
       <TextView
           android:id="@+id/text_tong_giohang"
           android:layout_width="0dp"
           android:layout_height="match_parent"
           android:textSize="20sp"
           android:gravity="center"
           android:padding="5dp"
           android:textStyle="bold"
           android:layout_weight="1.3"
           android:text="Tổng:000.VNĐ"
           android:textColor="#B1170C"
           />
       <Button
           android:layout_width="0dp"
           android:layout_weight="0.7"
           android:layout_height="match_parent"
           android:text="Gọi Món"
           android:textSize="18dp"
           android:textStyle="bold"
           android:id="@+id/button_goimon_giohang"
           android:backgroundTint="#E87753" />
   </LinearLayout>



</FrameLayout>