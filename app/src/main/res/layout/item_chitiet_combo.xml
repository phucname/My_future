<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:maxWidth="500dp"
    android:minWidth="200dp"
    android:orientation="vertical"
    android:id="@+id/item_linear_mon_combo"

    >
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:cardCornerRadius="20dp"
        android:layout_margin="10dp">
        <ImageView
            android:src="@drawable/backgound_dangnhap"
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:scaleType="fitXY"
            android:id="@+id/item_img_mon_combo">
        </ImageView>
    </androidx.cardview.widget.CardView>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tên Món Ăn"
        android:textSize="20dp"
        android:layout_marginLeft="20dp"
        android:textColor="#2FD55E"
        android:id="@+id/item_text_tenmon_combo"/>
    <TextView

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="Giá"
        android:textSize="20dp"
        android:textColor="#FF5722"
        android:id="@+id/item_text_giamon_combo"
        android:textStyle="bold"
        android:layout_marginLeft="20dp"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Số Lượng"
        android:textSize="20dp"
        android:layout_marginLeft="20dp"
        android:textColor="#000000"
        android:textStyle="bold"
        android:id="@+id/item_text_slmon_combo"/>

</LinearLayout>